<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se233.work_space.controller.MainController" stylesheets="@Style.css">
    <!-- Top Panel: Zoom Controls[cite: 3] -->
    <top>
        <ToolBar fx:id="topPanel">
            <Button text="Zoom In" onAction="#handleZoomIn" />
            <Button text="Zoom Out" onAction="#handleZoomOut" />
            <Button text="Zoom to Fit" onAction="#handleZoomFit" />
        </ToolBar>
    </top>

    <!-- Center Preview: Original vs Vectorized[cite: 3] -->
    <center>
            <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                <!-- ฝั่งซ้าย ภาพต้นฉบับ -->
                <VBox alignment="CENTER">
                    <Label text="Original Image" />
                    <!-- ใช้ fx:include หรือฝัง ZoomableImagePane ผ่าน Java -->
                    <StackPane fx:id="originalImageContainer" VBox.vgrow="ALWAYS" />
                </VBox>
                <!-- ฝั่งขวา ภาพเวกเตอร์ -->
                <VBox alignment="CENTER">
                    <Label text="Vectorized Result" />
                    <StackPane fx:id="vectorImageContainer" VBox.vgrow="ALWAYS" />
                </VBox>
            </SplitPane>
    </center>



    <!-- Right-handed Panel: Configurations[cite: 3] -->
    <right>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f4f4f4;" prefWidth="250">
            <Button text="Export All" onAction="#handleExportAll" styleClass="export-btn" maxWidth="Infinity" />

            <Label text="Improve result" style="-fx-font-weight: bold; -fx-font-size: 14;" />
            <Label text="Detail level:" />
            <ComboBox fx:id="detailLevelCombo" maxWidth="Infinity" />

            <Label text="Colors:" />
            <HBox spacing="10">
                <RadioButton fx:id="colorUnlimitedRadio" text="Unlimited" />
                <RadioButton fx:id="colorCustomRadio" text="Custom" />
            </HBox>
            <Spinner fx:id="customColorSpinner" min="2" max="5" initialValue="2" maxWidth="Infinity" />

            <Label text="Advanced" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 10 0 0 0;" />
            <CheckBox fx:id="removeBgCheckbox" text="Remove Background" />

            <!-- Progress Bar สำหรับ Parallel Processing[cite: 5] -->
            <ProgressBar fx:id="progressBar" progress="0.0" visible="false" maxWidth="Infinity" />

            <!-- Navigation[cite: 3] ## ย้ายตรงนี้ให้ปุ่มเปลี่ยนภาพอยู่แผงขวาของจอตามแบบของอาจารย์-->
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="8" alignment="CENTER">
                <Label fx:id="imageStatusLabel" text="Image 1 of 1" />
                <HBox spacing="10">
                    <Button text="← Back" onAction="#handleBack"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Button text="Next →" onAction="#handleNext"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </VBox>
    </right>
</BorderPane>