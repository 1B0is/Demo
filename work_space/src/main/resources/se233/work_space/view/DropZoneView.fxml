<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- # หน้าแรก: กล่อง Drag files here -->
<StackPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="se233.work_space.controller.DropZoneController"
            styleClass="root-pane">

    <VBox fx:id="dropZone" alignment="CENTER" spacing="12"
          maxWidth="420" maxHeight="280" styleClass="drop-zone"
          onDragOver="#handleDragOver"
          onDragExited="#handleDragExited"
          onDragDropped="#handleDragDropped">
        <Label text="⬇" styleClass="drop-icon"/>
        <Label text="Drag file(s) here" styleClass="drop-text"/>
        <Label text="JPG, PNG or ZIP" styleClass="drop-hint"/>
    </VBox>
</StackPane>
